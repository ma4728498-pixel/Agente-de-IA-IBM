## Spec da knowledge base — salve como knowledge_base/compras_kb.yaml:

spec_version: v1
kind: knowledge_base
name: compras_conformidade_kb
description: |
  Contém o histórico de compras da empresa e a matriz de contatos/aprovadores
  autorizados para validar transações com divergência de preço.
documents:
  - "knowledge_base/docs/historico_compras.csv"
  - "knowledge_base/docs/matriz_aprovadores.json"
conversational_search_tool:
  generation:
    max_docs_passed_to_llm: 10
    generated_response_length: Verbose
  confidence_thresholds:
    retrieval_confidence_threshold: Low
    response_confidence_threshold: Low
  query_rewrite:
    enabled: true
  citations:
    citations_shown: -1
